# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Authentication (better-auth)
# Mínimo 32 caracteres aleatórios (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"). Obrigatório em produção.
AUTH_SECRET=your-secret-key-here-min-32-chars
AUTH_URL=http://localhost:3000

# Storage (MinIO/S3 compatible)
# Pasta dos arquivos de evidência. Em produção, use armazenamento em nuvem.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=evidencias
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=us-east-1

# Application
AI_PROVIDER=none
NODE_ENV=development